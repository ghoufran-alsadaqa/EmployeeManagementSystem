#ifndef INTERN_H
#define INTERN_H

#include <string>
#include <iostream>
#include "Employee.h"

class Intern : public Employee
{
public:
    Intern(const std::string& n, int i, double st)
        : Employee(n, i, st) {}

    double calculateSalary() const override {
        return baseSalary;
    }

    void display() const override {
        std::cout << "== Intern ==\n"
                  << "Name    : " << name << "\n"
                  << "ID      : " << personID << "\n"
                  << "Stipend : " << baseSalary << "\n";
    }
};

#endif
